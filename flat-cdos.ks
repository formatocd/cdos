# Generated by pykickstart v3.69
#version=F44
# Firewall configuration
firewall --enabled --service=mdns
# Keyboard layouts
keyboard 'us'
# System language
lang en_US.UTF-8
# Network information
network  --bootproto=dhcp --device=link --activate
# Shutdown after installation
shutdown
repo --name="fedora" --mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-44&arch=$basearch
repo --name="updates" --mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=updates-released-f44&arch=$basearch
# Root password
#rootpw --iscrypted --lock locked
# SELinux configuration
selinux --enforcing
# System services
services --disabled="sshd" --enabled="NetworkManager,ModemManager"
# System timezone
timezone US/Eastern
# Use network installation
url --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-44&arch=$basearch"
# X Window System configuration information
xconfig  --startxonboot
# System bootloader configuration
bootloader --location=none
# Clear the Master Boot Record
zerombr
# Partition clearing information
clearpart --all
# Disk partitioning information
part / --fstype="ext4" --size=20000

%post
# Enable livesys services
systemctl enable livesys.service
systemctl enable livesys-late.service

# enable tmpfs for /tmp
systemctl enable tmp.mount

# make it so that we don't do writing to the overlay for things which
# are just tmpdirs/caches
# note https://bugzilla.redhat.com/show_bug.cgi?id=1135475
cat >> /etc/fstab << EOF
vartmp   /var/tmp    tmpfs   defaults   0  0
EOF

# work around for poor key import UI in PackageKit
rm -f /var/lib/rpm/__db*
echo "Packages within this LiveCD"
rpm -qa --qf '%{size}\t%{name}-%{version}-%{release}.%{arch}\n' |sort -rn
# Note that running rpm recreates the rpm db files which aren't needed or wanted
rm -f /var/lib/rpm/__db*

# go ahead and pre-make the man -k cache (#455968)
/usr/bin/mandb

# make sure there aren't core files lying around
rm -f /core*

# remove random seed, the newly installed instance should make it's own
rm -f /var/lib/systemd/random-seed

# convince readahead not to collect
# FIXME: for systemd

echo 'File created by kickstart. See systemd-update-done.service(8).' \
    | tee /etc/.updated >/var/.updated

# Drop the rescue kernel and initramfs, we don't need them on the live media itself.
# See bug 1317709
rm -f /boot/*-rescue*

# Disable network service here, as doing it in the services line
# fails due to RHBZ #1369794
systemctl disable network

# Remove machine-id on pre generated images
rm -f /etc/machine-id
touch /etc/machine-id

%end

%post

# set default GTK+ theme for root (see #683855, #689070, #808062)
cat > /root/.gtkrc-2.0 << EOF
include "/usr/share/themes/Adwaita/gtk-2.0/gtkrc"
include "/etc/gtk-2.0/gtkrc"
gtk-theme-name="Adwaita"
EOF
mkdir -p /root/.config/gtk-3.0
cat > /root/.config/gtk-3.0/settings.ini << EOF
[Settings]
gtk-theme-name = Adwaita
EOF

# set livesys session type
sed -i 's/^livesys_session=.*/livesys_session="kde"/' /etc/sysconfig/livesys

%end

%post
# =============================================================
# 1. IDENTIDAD DEL SISTEMA (CDOS)
# =============================================================
rm -f /etc/os-release /usr/lib/os-release
cat << 'OS_EOF' > /usr/lib/os-release
NAME="CDOS"
ID=cdos
ID_LIKE="fedora"
VERSION="1.0"
VERSION_ID="1.0"
PRETTY_NAME="CDOS 1.0"
ANSI_COLOR="0;34"
DEFAULT_HOSTNAME="cdos"
OS_EOF
cp -f /usr/lib/os-release /etc/os-release

echo "cdos" > /etc/hostname
echo "CDOS 1.0 (\l)" > /etc/issue
echo "CDOS 1.0" > /etc/issue.net
echo "CDOS release 1.0" > /etc/system-release
grep -q "excludepkgs=fedora-release-identity" /etc/dnf/dnf.conf || echo "excludepkgs=fedora-release-identity*" >> /etc/dnf/dnf.conf

# =============================================================
# 2. SOPORTE EFI PARA LORAX
# =============================================================
mkdir -p /boot/efi/EFI
cp -r /boot/efi/EFI/fedora /boot/efi/EFI/cdos 2>/dev/null || true

# =============================================================
# 3. ENTORNO RHEL UBI
# =============================================================
cat > /usr/local/bin/cdos-init-rhel-env << 'RHEL_EOF'
#!/bin/bash
echo "=== [CDOS] Inicializando entorno de compilación RHEL 9 UBI ==="
distrobox create --name rhel9-builder --image registry.access.redhat.com/ubi9/ubi:latest --yes
echo "=== [CDOS] Entorno listo. Accede con: distrobox enter rhel9-builder ==="
RHEL_EOF
chmod +x /usr/local/bin/cdos-init-rhel-env

cat > /usr/share/applications/cdos-rhel-builder.desktop << 'DESK_EOF'
[Desktop Entry]
Name=CDOS RHEL 9 Builder
Comment=Entorno de desarrollo y compilación binaria compatible con RHEL 9
Exec=konsole -e bash -c "distrobox enter rhel9-builder || /usr/local/bin/cdos-init-rhel-env && distrobox enter rhel9-builder"
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=Development;
DESK_EOF

# =============================================================
# 4. BRANDING VISUAL CDOS (PNG TRANSPARENTE)
# =============================================================
mkdir -p /usr/share/icons/hicolor/512x512/apps
echo "" | base64 -d > /usr/share/icons/hicolor/512x512/apps/cdos-logo.png

for sz in 16 22 24 32 48 64 128 256; do
    mkdir -p /usr/share/icons/hicolor/${sz}x${sz}/apps
    mkdir -p /usr/share/icons/hicolor/${sz}x${sz}/places
    python3 -c "from PIL import Image; Image.open('/usr/share/icons/hicolor/512x512/apps/cdos-logo.png').resize((${sz}, ${sz}), getattr(Image, 'Resampling', Image).LANCZOS).save('/usr/share/icons/hicolor/${sz}x${sz}/apps/cdos-logo.png')"
    cp -f /usr/share/icons/hicolor/${sz}x${sz}/apps/cdos-logo.png /usr/share/icons/hicolor/${sz}x${sz}/apps/fedora-logo-icon.png 2>/dev/null || true
    cp -f /usr/share/icons/hicolor/${sz}x${sz}/apps/cdos-logo.png /usr/share/icons/hicolor/${sz}x${sz}/apps/org.fedoraproject.AnacondaInstaller.png 2>/dev/null || true
    cp -f /usr/share/icons/hicolor/${sz}x${sz}/apps/cdos-logo.png /usr/share/icons/hicolor/${sz}x${sz}/apps/liveinst.png 2>/dev/null || true
    cp -f /usr/share/icons/hicolor/${sz}x${sz}/apps/cdos-logo.png /usr/share/icons/hicolor/${sz}x${sz}/places/start-here.png 2>/dev/null || true
done

mkdir -p /usr/share/icons/breeze/places /usr/share/icons/breeze-dark/places
cp -f /usr/share/icons/hicolor/64x64/apps/cdos-logo.png /usr/share/icons/breeze/places/start-here-kde.png 2>/dev/null || true
cp -f /usr/share/icons/hicolor/64x64/apps/cdos-logo.png /usr/share/icons/breeze-dark/places/start-here-kde.png 2>/dev/null || true
cp -f /usr/share/icons/hicolor/64x64/apps/cdos-logo.png /usr/share/icons/breeze/places/start-here-kde-fedora.svg 2>/dev/null || true
cp -f /usr/share/icons/hicolor/64x64/apps/cdos-logo.png /usr/share/icons/breeze-dark/places/start-here-kde-fedora.svg 2>/dev/null || true

# Plymouth
mkdir -p /usr/share/plymouth/themes/spinner
cp -f /usr/share/icons/hicolor/128x128/apps/cdos-logo.png /usr/share/plymouth/themes/spinner/watermark.png
cp -f /usr/share/icons/hicolor/128x128/apps/cdos-logo.png /usr/share/pixmaps/fedora-logo-sprite.png 2>/dev/null || true
cp -f /usr/share/icons/hicolor/128x128/apps/cdos-logo.png /usr/share/pixmaps/system-logo-white.png 2>/dev/null || true

# Wallpaper 1920x1080
mkdir -p /usr/share/wallpapers/CDOS-Default/contents/images
python3 - << 'PYWP'
from PIL import Image, ImageDraw, ImageFont

wp = Image.new('RGB', (1920, 1080), color='#070d18')
draw = ImageDraw.Draw(wp)

for x in range(0, 1920, 320):
    draw.line([(x, 0), (x, 1080)], fill='#0e192c', width=1)
for y in range(0, 1080, 180):
    draw.line([(0, y), (1920, y)], fill='#0e192c', width=1)

logo = Image.open('/usr/share/icons/hicolor/512x512/apps/cdos-logo.png').convert('RGBA')
logo_scaled = logo.resize((420, 420), getattr(Image, 'Resampling', Image).LANCZOS)
wp.paste(logo_scaled, ((1920 - 420) // 2, 220), mask=logo_scaled)

try:
    font = ImageFont.truetype('/usr/share/fonts/liberation-sans/LiberationSans-Bold.ttf', 60)
except Exception:
    font = ImageFont.load_default()

text = "CDOS"
bbox = draw.textbbox((0, 0), text, font=font)
t_w = bbox[2] - bbox[0]
draw.text(((1920 - t_w) // 2, 680), text, fill='#ffffff', font=font)

wp.save('/usr/share/wallpapers/CDOS-Default/contents/images/1920x1080.png')
wp.save('/usr/share/wallpapers/CDOS-Default/contents/images/1920x1080_dark.png')
PYWP

cat << 'JSON' > /usr/share/wallpapers/CDOS-Default/metadata.json
{"KPlugin": {"Id": "CDOS-Default", "Name": "CDOS"}}
JSON

for wp in F44 Next default; do
    rm -rf /usr/share/wallpapers/$wp
    ln -sf /usr/share/wallpapers/CDOS-Default /usr/share/wallpapers/$wp
done

# Accesos directos del instalador
find /usr/share/applications /etc/skel/Desktop -name "*liveinst*.desktop" -o -name "*Anaconda*.desktop" 2>/dev/null | while read -r dfile; do
    sed -i '/^Name\[/d' "$dfile"
    sed -i 's/^Name=.*/Name=Install CDOS/' "$dfile"
    sed -i 's/^Icon=.*/Icon=cdos-logo/' "$dfile"
done

for lscript in /etc/rc.d/init.d/livesys /usr/libexec/livesys/sessions.d/livesys-kde; do
    if [ -f "$lscript" ]; then
        sed -i 's/Install to Hard Drive/Install CDOS/g' "$lscript"
    fi
done

touch /usr/share/icons/hicolor
if command -v gtk-update-icon-cache &>/dev/null; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi
%end

