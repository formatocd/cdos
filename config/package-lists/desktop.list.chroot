# Entorno de escritorio KDE Plasma (mínimo)
kde-plasma-desktop

# Gestor de pantalla (login gráfico)
sddm

# Servidor gráfico X11 (necesario para SDDM y para una experiencia live predecible)
xserver-xorg

# Gestor de ventanas para la sesión X11
kwin-x11

# Herramientas de gestión de energía y discos (dependencias recomendadas)
upower
udisks2

# Esenciales del escritorio (recommends de kde-plasma-desktop que
# excluimos con LB_APT_RECOMMENDS=false y añadimos explícitamente)
konsole
plasma-nm
xdg-desktop-portal-kde
kde-spectacle
ark
kate

# Aplicaciones del sistema (recommends de kde-plasma-desktop que
# excluimos con LB_APT_RECOMMENDS=false; sin ellas, el panel de
# Plasma muestra lanzadores fantasma)
systemsettings
plasma-discover

# Shell interactivo para el usuario (sustituye a bash en Konsole,
# pero NO se establece como shell de login para evitar problemas
# con Plasma)
fish

# Herramienta de información del sistema (invocable manualmente,
# no auto-ejecutada en Konsole para no molestar en el uso diario)
fastfetch

# Navegador web por defecto (necesario para los enlaces del welcome
# y para uso diario del desarrollador)
firefox-esr
